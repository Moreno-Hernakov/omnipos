<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- Sesuaikan dengan server MySQL/MariaDB setempat. Jangan menulis kredensial di kode C#. -->
    <add name="OmniPosDb"
         connectionString="Server=127.0.0.1;Port=3306;Database=db_uas_pos;Uid=omnipos_app;Pwd=omnipos_dev;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
